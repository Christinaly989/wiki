  "client/README.md": "# React + TypeScript + Vite\n\nThis template provides a minimal setup to get React working in Vite with HMR and some ESLint rules.\n\nCurrently, two official plugins are available:\n\n- [@vitejs/plugin-react](https://github.com/vitejs/vite-plugin-react/blob/main/packages/plugin-react) uses [Oxc](https://oxc.rs)\n- [@vitejs/plugin-react-swc](https://github.com/vitejs/vite-plugin-react/blob/main/packages/plugin-react-swc) uses [SWC](https://swc.rs/)\n\n## React Compiler\n\nThe React Compiler is not enabled on this template because of its impact on dev & build performances. To add it, see [this documentation](https://react.dev/learn/react-compiler/installation).\n\n## Expanding the ESLint configuration\n\nIf you are developing a production application, we recommend updating the configuration to enable type-aware lint rules:\n\n```js\nexport default defineConfig([\n  globalIgnores(['dist']),\n  {\n    files: ['**/*.{ts,tsx}'],\n    extends: [\n      // Other configs...\n\n      // Remove tseslint.configs.recommended and replace with this\n      tseslint.configs.recommendedTypeChecked,\n      // Alternatively, use this for stricter rules\n      tseslint.configs.strictTypeChecked,\n      // Optionally, add this for stylistic rules\n      tseslint.configs.stylisticTypeChecked,\n\n      // Other configs...\n    ],\n    languageOptions: {\n      parserOptions: {\n        project: ['./tsconfig.node.json', './tsconfig.app.json'],\n        tsconfigRootDir: import.meta.dirname,\n      },\n      // other options...\n    },\n  },\n])\n```\n\nYou can also install [eslint-plugin-react-x](https://github.com/Rel1cx/eslint-react/tree/main/packages/plugins/eslint-plugin-react-x) and [eslint-plugin-react-dom](https://github.com/Rel1cx/eslint-react/tree/main/packages/plugins/eslint-plugin-react-dom) for React-specific lint rules:\n\n```js\n// eslint.config.js\nimport reactX from 'eslint-plugin-react-x'\nimport reactDom from 'eslint-plugin-react-dom'\n\nexport default defineConfig([\n  globalIgnores(['dist']),\n  {\n    files: ['**/*.{ts,tsx}'],\n    extends: [\n      // Other configs...\n      // Enable lint rules for React\n      reactX.configs['recommended-typescript'],\n      // Enable lint rules for React DOM\n      reactDom.configs.recommended,\n    ],\n    languageOptions: {\n      parserOptions: {\n        project: ['./tsconfig.node.json', './tsconfig.app.json'],\n        tsconfigRootDir: import.meta.dirname,\n      },\n      // other options...\n    },\n  },\n])\n```\n",
  "client/src/api.ts": "import type { DashboardPayload } from \"./types\"\n\nfunction normalizeMetric(metric: any) {\n  const history = Array.isArray(metric?.history)\n    ? metric.history.filter(\n        (point: any) => typeof point?.date === \"string\" && Number.isFinite(point?.value),\n      )\n    : []\n\n  return {\n    ...metric,\n    category: metric?.category ?? \"\",\n    sourceLabel: metric?.sourceLabel ?? \"Unknown\",\n    definition: metric?.definition ?? \"Level\",\n    frequencyLabel: metric?.frequencyLabel ?? metric?.frequency ?? \"N/A\",\n    marketSignal: metric?.marketSignal ?? \"Monitoring\",\n    history,\n    valueText: metric?.valueText ?? \"N/A\",\n    changeText: metric?.changeText ?? \"N/A\",\n    changeDirection:\n      metric?.changeDirection === \"up\" || metric?.changeDirection === \"down\" || metric?.changeDirection === \"flat\"\n        ? metric.changeDirection\n        : \"flat\",\n    asOfText: metric?.asOfText ?? \"N/A\",\n    isStale: Boolean(metric?.isStale),\n    statusLabel: metric?.statusLabel ?? \"Watch\",\n    statusTone:\n      metric?.statusTone === \"positive\" ||\n      metric?.statusTone === \"caution\" ||\n      metric?.statusTone === \"negative\" ||\n      metric?.statusTone === \"neutral\"\n        ? metric.statusTone\n        : \"neutral\",\n    brief: typeof metric?.brief === \"string\" && metric.brief.trim() ? metric.brief : metric?.marketSignal ?? \"Monitoring\",\n  }\n}\n\nfunction normalizeSection(section: any) {\n  return {\n    ...section,\n    title: section?.title ?? \"\",\n    lead: section?.lead ?? \"\",\n    perspective: section?.perspective ?? \"\",\n    metrics: Array.isArray(section?.metrics) ? section.metrics.map(normalizeMetric) : [],\n  }\n}\n\nfunction normalizeDashboard(payload: any): DashboardPayload {\n  return {\n    ...payload,\n    warnings: Array.isArray(payload?.warnings) ? payload.warnings.filter((item: any) => typeof item === \"string\") : [],\n    topSignals: Array.isArray(payload?.topSignals) ? payload.topSignals : [],\n    feed: Array.isArray(payload?.feed) ? payload.feed : [],\n    sections: Array.isArray(payload?.sections) ? payload.sections.map(normalizeSection) : [],\n    releases: {\n      sevenDays: Array.isArray(payload?.releases?.sevenDays) ? payload.releases.sevenDays : [],\n      thirtyDays: Array.isArray(payload?.releases?.thirtyDays) ? payload.releases.thirtyDays : [],\n    },\n  } as DashboardPayload\n}\n\nasync function request(path: string, options?: RequestInit): Promise<DashboardPayload> {\n  const response = await fetch(path, {\n    headers: {\n      \"content-type\": \"application/json\",\n    },\n    ...options,\n  })\n\n  if (!response.ok) {\n    const payload = (await response.json().catch(() => null)) as { error?: string } | null\n    throw new Error(payload?.error ?? `Request failed: ${response.status}`)\n  }\n\n  return normalizeDashboard(await response.json())\n}\n\nexport function fetchDashboard() {\n  return request(\"/api/dashboard\")\n}\n\nexport function refreshDashboard() {\n  return request(\"/api/refresh\", {\n    method: \"POST\",\n  })\n}\n\nexport function publishNotionBrief() {\n  return request(\"/api/publish/notion\", {\n    method: \"POST\",\n  })\n}\n",
  "client/src/App.css": ".app-shell {\n  width: min(1520px, calc(100vw - 36px));\n  margin: 0 auto;\n  padding: 28px 0 56px;\n}\n\n.loading-state {\n  min-height: 100vh;\n  display: grid;\n  place-items: center;\n  color: var(--ink-soft);\n}\n\n.hero-panel {\n  display: grid;\n  grid-template-columns: 1.35fr 0.95fr;\n  gap: 20px;\n  margin-bottom: 18px;\n}\n\n.hero-copy,\n.regime-panel,\n.toolbar,\n.publishing-panel,\n.panel-card,\n.signal-card,\n.table-panel,\n.warning-ribbon {\n  border-radius: 24px;\n  border: 1px solid var(--line);\n  box-shadow: 0 20px 60px rgba(7, 19, 37, 0.14);\n}\n\n.hero-copy {\n  padding: 30px;\n  background:\n    radial-gradient(circle at top left, rgba(252, 180, 70, 0.18), transparent 36%),\n    radial-gradient(circle at bottom right, rgba(38, 125, 164, 0.14), transparent 30%),\n    linear-gradient(150deg, rgba(248, 242, 232, 0.96), rgba(255, 250, 244, 0.98));\n}\n\n.eyebrow {\n  margin: 0 0 10px;\n  text-transform: uppercase;\n  letter-spacing: 0.2em;\n  font-size: 0.78rem;\n  color: var(--accent);\n}\n\n.hero-copy h1 {\n  margin: 0 0 14px;\n  font-size: clamp(2.4rem, 4vw, 4.2rem);\n  line-height: 0.95;\n  letter-spacing: -0.05em;\n}\n\n.hero-summary,\n.section-perspective {\n  color: var(--ink-soft);\n}\n\n.hero-summary {\n  margin: 0 0 18px;\n  max-width: 860px;\n  font-size: 1.08rem;\n}\n\n.hero-meta,\n.source-grid,\n.publishing-meta {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 10px 14px;\n  color: var(--muted);\n  font-size: 0.92rem;\n}\n\n.regime-panel {\n  padding: 26px;\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n.regime-label {\n  text-transform: uppercase;\n  letter-spacing: 0.16em;\n  color: var(--muted);\n  font-size: 0.78rem;\n}\n\n.regime-panel strong {\n  font-size: 2.5rem;\n  line-height: 1;\n}\n\n.regime-gold {\n  background: linear-gradient(180deg, rgba(242, 243, 224, 0.96), rgba(255, 250, 241, 0.98));\n}\n\n.regime-red {\n  background: linear-gradient(180deg, rgba(255, 236, 227, 0.96), rgba(255, 250, 244, 0.98));\n}\n\n.regime-blue {\n  background: linear-gradient(180deg, rgba(231, 240, 250, 0.97), rgba(250, 253, 255, 0.98));\n}\n\n.regime-amber {\n  background: linear-gradient(180deg, rgba(255, 237, 221, 0.96), rgba(255, 249, 242, 0.98));\n}\n\n.score-strip {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 12px;\n}\n\n.score-strip-3 {\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n}\n\n.score-strip div {\n  padding: 12px 14px;\n  border-radius: 18px;\n  background: rgba(255, 255, 255, 0.68);\n}\n\n.score-strip small {\n  display: block;\n  color: var(--muted);\n}\n\n.driver-list {\n  margin: 0;\n  padding-left: 18px;\n  color: var(--ink-soft);\n}\n\n.toolbar,\n.publishing-panel {\n  padding: 16px 18px;\n  margin-bottom: 18px;\n  background: var(--panel);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 18px;\n}\n\n.strategy-grid,\n.monitor-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 18px;\n  margin-bottom: 18px;\n  align-items: stretch;\n}\n\n.strategy-grid > *,\n.monitor-grid > * {\n  min-width: 0;\n  width: 100%;\n}\n\n.toolbar-left {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  flex-wrap: wrap;\n}\n\n.action-button,\n.secondary-button,\n.timezone-toggle button {\n  border: 0;\n  cursor: pointer;\n  border-radius: 999px;\n  padding: 11px 16px;\n  font: inherit;\n}\n\n.action-button {\n  background: linear-gradient(135deg, #0e4b73, #156558);\n  color: #fdf8f0;\n}\n\n.secondary-button {\n  background: rgba(13, 26, 47, 0.88);\n  color: #f7f0e4;\n}\n\n.action-button:disabled,\n.secondary-button:disabled {\n  opacity: 0.6;\n  cursor: wait;\n}\n\n.timezone-toggle {\n  background: rgba(17, 52, 71, 0.08);\n  border-radius: 999px;\n  padding: 4px;\n  display: inline-flex;\n}\n\n.timezone-toggle button {\n  color: var(--ink-soft);\n  background: transparent;\n}\n\n.timezone-toggle button.active {\n  background: #fff8ef;\n  box-shadow: 0 8px 24px rgba(14, 31, 46, 0.08);\n}\n\n.publishing-panel h2,\n.panel-head h2,\n.section-head h2 {\n  margin: 0 0 6px;\n}\n\n.strategy-summary {\n  margin: 0 0 12px;\n  color: var(--ink-soft);\n}\n\n.strategy-list {\n  margin: 0;\n  padding-left: 18px;\n  color: var(--ink-soft);\n}\n\n.strategy-list li + li {\n  margin-top: 8px;\n}\n\n.ai-overlay-panel {\n  margin-bottom: 18px;\n}\n\n.ai-grid {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 18px;\n}\n\n.ai-meta {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px 12px;\n  color: var(--muted);\n  font-size: 0.9rem;\n}\n\n.ai-subhead {\n  display: block;\n  margin-bottom: 8px;\n  font-size: 1rem;\n  color: var(--ink);\n}\n\n.ai-risks {\n  margin-top: 18px;\n}\n\n.ai-risks h3 {\n  margin: 0 0 10px;\n  font-size: 1rem;\n}\n\n.publishing-meta a {\n  color: #195d83;\n  text-decoration: none;\n}\n\n.setup-banner {\n  padding: 16px 18px;\n  margin-bottom: 18px;\n  border-radius: 22px;\n  border: 1px solid rgba(21, 79, 135, 0.14);\n  background: linear-gradient(135deg, rgba(229, 243, 250, 0.94), rgba(247, 252, 255, 0.95));\n  color: #1f5777;\n  box-shadow: 0 18px 50px rgba(17, 52, 71, 0.06);\n}\n\n.setup-banner p,\n.warning-ribbon p {\n  margin: 0;\n}\n\n.setup-banner p + p,\n.warning-ribbon p + p {\n  margin-top: 8px;\n}\n\n.warning-ribbon {\n  padding: 16px 18px;\n  margin-bottom: 18px;\n  background: linear-gradient(135deg, rgba(255, 235, 223, 0.92), rgba(255, 249, 241, 0.94));\n}\n\n.warning-ribbon p {\n  color: #9a4d23;\n}\n\n.signal-grid {\n  display: grid;\n  grid-template-columns: repeat(6, minmax(0, 1fr));\n  gap: 14px;\n  margin-bottom: 18px;\n}\n\n.signal-card {\n  padding: 18px;\n  background: var(--panel);\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.signal-card small,\n.signal-card time {\n  color: var(--muted);\n}\n\n.signal-card strong {\n  font-size: 1.25rem;\n}\n\n.insight-grid {\n  display: grid;\n  grid-template-columns: 1.08fr 0.92fr;\n  gap: 18px;\n  margin-bottom: 18px;\n}\n\n.panel-card {\n  padding: 20px;\n  background: var(--panel);\n}\n\n.panel-head {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: 12px;\n  margin-bottom: 14px;\n}\n\n.feed-list,\n.release-list,\n.calendar-grid,\n.chart-grid,\n.monitor-list {\n  display: grid;\n  gap: 14px;\n}\n\n.feed-list,\n.release-list,\n.calendar-grid {\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n}\n\n.feed-item,\n.release-card,\n.chart-card,\n.monitor-item {\n  padding: 16px;\n  border-radius: 18px;\n  border: 1px solid rgba(18, 53, 71, 0.1);\n  background: rgba(255, 255, 255, 0.7);\n}\n\n.monitor-panel {\n  display: grid;\n  gap: 18px;\n  height: 100%;\n  align-content: start;\n}\n\n.monitor-section {\n  display: grid;\n  gap: 12px;\n}\n\n.monitor-section h3 {\n  margin: 0;\n  font-size: 0.96rem;\n  letter-spacing: 0.04em;\n  text-transform: uppercase;\n  color: var(--muted);\n}\n\n.monitor-topline {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: 12px;\n  margin-bottom: 8px;\n}\n\n.monitor-item strong {\n  display: block;\n  margin-bottom: 6px;\n}\n\n.monitor-item p {\n  margin: 0 0 10px;\n  color: var(--ink-soft);\n}\n\n.monitor-item {\n  display: flex;\n  flex-direction: column;\n  height: 100%;\n}\n\n.monitor-item a {\n  color: #195d83;\n  text-decoration: none;\n}\n\n.monitor-list-compact {\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n}\n\n.monitor-list-compact .monitor-item {\n  min-height: 180px;\n}\n\n.feed-topline,\n.release-topline {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: 12px;\n}\n\n.feed-item p,\n.release-card p {\n  margin: 8px 0;\n  color: var(--ink-soft);\n}\n\n.severity-high {\n  border-left: 5px solid #b64f26;\n}\n\n.severity-medium {\n  border-left: 5px solid #1f6a84;\n}\n\n.severity-low {\n  border-left: 5px solid #2f7a5a;\n}\n\n.importance-high {\n  border-left: 5px solid #b64f26;\n}\n\n.importance-medium {\n  border-left: 5px solid #1f6a84;\n}\n\n.importance-low {\n  border-left: 5px solid #2f7a5a;\n}\n\n.release-high {\n  background: linear-gradient(180deg, rgba(255, 242, 235, 0.96), rgba(255, 255, 255, 0.92));\n}\n\n.release-medium {\n  background: linear-gradient(180deg, rgba(235, 246, 252, 0.96), rgba(255, 255, 255, 0.92));\n}\n\n.calendar-grid {\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n}\n\n.macro-section {\n  margin-top: 28px;\n}\n\n.section-head {\n  margin-bottom: 14px;\n}\n\n.section-perspective {\n  margin: 10px 0 0;\n  max-width: 920px;\n}\n\n.table-panel {\n  overflow: hidden;\n  background: linear-gradient(180deg, rgba(7, 14, 29, 0.98), rgba(13, 20, 38, 0.98));\n  margin-bottom: 16px;\n}\n\n.table-scroll {\n  overflow-x: auto;\n}\n\n.indicator-table {\n  width: 100%;\n  min-width: 1320px;\n  border-collapse: collapse;\n  color: #f5f1ea;\n}\n\n.indicator-table th,\n.indicator-table td {\n  padding: 14px 16px;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.08);\n  text-align: left;\n  vertical-align: top;\n}\n\n.indicator-table thead th {\n  font-size: 0.88rem;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n  color: rgba(237, 241, 246, 0.82);\n}\n\n.table-bands th {\n  background: rgba(255, 255, 255, 0.03);\n}\n\n.table-bands .view-band,\n.view-col-head,\n.view-col {\n  background: rgba(25, 92, 130, 0.14);\n}\n\n.indicator-table tbody tr:hover td {\n  background: rgba(255, 255, 255, 0.04);\n}\n\n.indicator-cell {\n  display: grid;\n  gap: 4px;\n}\n\n.indicator-cell span {\n  color: rgba(216, 224, 236, 0.68);\n  font-size: 0.88rem;\n}\n\n.value-cell {\n  font-weight: 700;\n}\n\n.asof-cell {\n  display: grid;\n  gap: 4px;\n}\n\n.stale-flag {\n  display: inline-flex;\n  width: fit-content;\n  border-radius: 999px;\n  padding: 2px 8px;\n  background: rgba(216, 74, 89, 0.18);\n  color: #ffb5bd;\n  font-size: 0.72rem;\n  letter-spacing: 0.04em;\n  text-transform: uppercase;\n}\n\n.change-up {\n  color: #58dc93;\n}\n\n.change-down {\n  color: #ff8f95;\n}\n\n.change-flat {\n  color: #d6deea;\n}\n\n.status-pill {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-width: 88px;\n  border-radius: 999px;\n  padding: 6px 10px;\n  font-size: 0.82rem;\n  font-weight: 700;\n}\n\n.status-positive {\n  background: #19b26d;\n  color: #f4fff7;\n}\n\n.status-caution {\n  background: #f0c233;\n  color: #1d1604;\n}\n\n.status-negative {\n  background: #d84a59;\n  color: #fff3f4;\n}\n\n.status-neutral {\n  background: rgba(255, 255, 255, 0.18);\n  color: #f0f3f8;\n}\n\n.brief-cell {\n  min-width: 280px;\n  color: rgba(243, 246, 251, 0.88);\n}\n\n.chart-grid {\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n}\n\n.chart-card {\n  background: var(--panel);\n}\n\n.chart-copy {\n  display: grid;\n  gap: 4px;\n}\n\n.chart-copy small,\n.chart-copy span {\n  color: var(--muted);\n}\n\n.chart-copy strong {\n  font-size: 1.05rem;\n}\n\n.chart-shell {\n  height: 180px;\n  margin-top: 10px;\n}\n\n.chart-shell-empty {\n  display: grid;\n  place-items: center;\n  color: var(--muted);\n  border: 1px dashed rgba(18, 53, 71, 0.18);\n  border-radius: 14px;\n}\n\n@media (max-width: 1200px) {\n  .hero-panel,\n  .insight-grid,\n  .ai-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .signal-grid {\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n  }\n\n  .calendar-grid,\n  .feed-list,\n  .release-list,\n  .chart-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n}\n\n@media (max-width: 920px) {\n  .strategy-grid,\n  .monitor-grid {\n    grid-template-columns: 1fr;\n  }\n}\n\n@media (max-width: 760px) {\n  .app-shell {\n    width: min(100vw - 22px, 1520px);\n    padding-top: 16px;\n  }\n\n  .toolbar,\n  .publishing-panel,\n  .toolbar-left,\n  .source-grid,\n  .publishing-meta {\n    flex-direction: column;\n    align-items: flex-start;\n  }\n\n  .signal-grid,\n  .feed-list,\n  .release-list,\n  .calendar-grid,\n  .chart-grid,\n  .monitor-list-compact {\n    grid-template-columns: 1fr;\n  }\n\n  .hero-copy h1 {\n    font-size: 2.3rem;\n  }\n}\n",
  "client/src/App.tsx": "import { startTransition, useEffect, useState } from \"react\"\nimport { fetchDashboard, publishNotionBrief, refreshDashboard } from \"./api\"\nimport { LineChart } from \"./components/LineChart\"\nimport type {\n  AiOverlaySection,\n  DashboardPayload,\n  MonitorItem,\n  ReleaseEvent,\n  Section,\n} from \"./types\"\nimport \"./App.css\"\n\nfunction formatDateTime(value: string, timeZone: string) {\n  return new Intl.DateTimeFormat(\"zh-CN\", {\n    timeZone,\n    year: \"numeric\",\n    month: \"2-digit\",\n    day: \"2-digit\",\n    hour: \"2-digit\",\n    minute: \"2-digit\",\n    hour12: false,\n  }).format(new Date(value))\n}\n\nfunction regimeTone(regime: DashboardPayload[\"regimeState\"][\"regime\"]) {\n  if (regime === \"Goldilocks\") return \"regime-gold\"\n  if (regime === \"Reflation\") return \"regime-red\"\n  if (regime === \"Recession\") return \"regime-blue\"\n  return \"regime-amber\"\n}\n\nfunction statusClass(metric: Section[\"metrics\"][number]) {\n  return `status-pill status-${metric.statusTone}`\n}\n\nfunction changeClass(metric: Section[\"metrics\"][number]) {\n  return `change-${metric.changeDirection}`\n}\n\nfunction sourceLabel(status: string) {\n  const map: Record<string, string> = {\n    ok: \"Live\",\n    partial: \"Partial\",\n    cached: \"Cached\",\n    missing_api_key: \"Missing Key\",\n    disabled: \"Disabled\",\n    pending: \"Pending\",\n    ready: \"Ready\",\n    stale: \"Stale\",\n    error: \"Error\",\n  }\n\n  return map[status] ?? status\n}\n\nfunction renderRelease(event: ReleaseEvent, timeZone: string) {\n  return (\n    <article className={`release-card release-${event.importance}`} key={event.eventId}>\n      <div className=\"release-topline\">\n        <span>{event.source}</span>\n        <span>{formatDateTime(event.releaseAtUtc, timeZone)}</span>\n      </div>\n      <h4>{event.name}</h4>\n      <p>{event.impact}</p>\n      {event.notes ? <small>{event.notes}</small> : null}\n    </article>\n  )\n}\n\nfunction renderSection(section: Section) {\n  const featuredMetrics = section.metrics.filter((metric) => (metric.history ?? []).length > 3).slice(0, 3)\n\n  return (\n    <section className=\"macro-section\" key={section.key}>\n      <div className=\"section-head\">\n        <div>\n          <p className=\"eyebrow\">{section.title}</p>\n          <h2>{section.lead}</h2>\n          <p className=\"section-perspective\">{section.perspective}</p>\n        </div>\n      </div>\n\n      <article className=\"table-panel\">\n        <div className=\"table-scroll\">\n          <table className=\"indicator-table\">\n            <thead>\n              <tr className=\"table-bands\">\n                <th colSpan={6}>Observable Data</th>\n                <th className=\"view-band\" colSpan={2}>\n                  House View\n                </th>\n              </tr>\n              <tr>\n                <th>Indicator</th>\n                <th>Value</th>\n                <th>Chg</th>\n                <th>Freq</th>\n                <th>As Of</th>\n                <th>Source</th>\n                <th className=\"view-col-head\">Status</th>\n                <th className=\"view-col-head\">Brief</th>\n              </tr>\n            </thead>\n            <tbody>\n              {section.metrics.map((metric) => (\n                <tr key={metric.key}>\n                  <td>\n                    <div className=\"indicator-cell\">\n                      <strong>{metric.label}</strong>\n                      <span>\n                        {metric.category} · {metric.definition}\n                      </span>\n                    </div>\n                  </td>\n                  <td className=\"value-cell\">{metric.valueText}</td>\n                  <td className={changeClass(metric)}>{metric.changeText}</td>\n                  <td>{metric.frequencyLabel}</td>\n                  <td>\n                    <div className=\"asof-cell\">\n                      <span>{metric.asOfText}</span>\n                      {metric.isStale ? <small className=\"stale-flag\">Stale</small> : null}\n                    </div>\n                  </td>\n                  <td>{metric.sourceLabel}</td>\n                  <td className=\"view-col\">\n                    <span className={statusClass(metric)}>{metric.statusLabel}</span>\n                  </td>\n                  <td className=\"view-col brief-cell\">{metric.brief}</td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n      </article>\n\n      {featuredMetrics.length ? (\n        <div className=\"chart-grid\">\n          {featuredMetrics.map((metric) => (\n            <article className=\"chart-card\" key={metric.key}>\n              <div className=\"chart-copy\">\n                <small>\n                  {metric.sourceLabel} · {metric.definition}\n                </small>\n                <strong>{metric.label}</strong>\n                <span>\n                  {metric.valueText} / {metric.asOfText}\n                </span>\n              </div>\n              <LineChart metric={metric} />\n            </article>\n          ))}\n        </div>\n      ) : null}\n    </section>\n  )\n}\n\nfunction renderMonitorItem(item: MonitorItem, timeZone: string) {\n  const title = item.displayTitle ?? item.title\n  const summary = item.displaySummary ?? item.summary\n  const showSummary = Boolean(summary && summary !== title)\n\n  return (\n    <article className={`monitor-item importance-${item.importance}`} key={item.id}>\n      <div className=\"monitor-topline\">\n        <span>{item.source}</span>\n        <span>{item.publishedAtLocal || formatDateTime(item.publishedAt, timeZone)}</span>\n      </div>\n      <strong>{title}</strong>\n      {showSummary ? <p>{summary}</p> : null}\n      {item.url ? (\n        <a href={item.url} rel=\"noreferrer\" target=\"_blank\">\n          打开原文\n        </a>\n      ) : null}\n    </article>\n  )\n}\n\nfunction renderMonitorPanel(\n  title: string,\n  dataUpdates: MonitorItem[],\n  news: MonitorItem[],\n  timeZone: string,\n) {\n  return (\n    <article className=\"panel-card monitor-panel\">\n      <div className=\"panel-head\">\n        <h2>{title}</h2>\n        <span>近 24 小时，周末自动回看至周五</span>\n      </div>\n      <div className=\"monitor-section\">\n        <h3>数据更新</h3>\n        <div className=\"monitor-list monitor-list-compact\">\n          {dataUpdates.map((item) => renderMonitorItem(item, timeZone))}\n        </div>\n      </div>\n      <div className=\"monitor-section\">\n        <h3>关键宏观新闻</h3>\n        <div className=\"monitor-list\">{news.map((item) => renderMonitorItem(item, timeZone))}</div>\n      </div>\n    </article>\n  )\n}\n\nfunction renderStrategyPanel(title: string, summary: string, bullets: string[]) {\n  return (\n    <article className=\"panel-card strategy-card\">\n      <div className=\"panel-head\">\n        <h2>{title}</h2>\n      </div>\n      <p className=\"strategy-summary\">{summary}</p>\n      <ul className=\"strategy-list\">\n        {bullets.map((bullet) => (\n          <li key={bullet}>{bullet}</li>\n        ))}\n      </ul>\n    </article>\n  )\n}\n\nfunction renderAiSection(title: string, section: AiOverlaySection) {\n  return (\n    <article className=\"panel-card ai-card\" key={title}>\n      <div className=\"panel-head\">\n        <h2>{title}</h2>\n      </div>\n      <strong className=\"ai-subhead\">{section.headline}</strong>\n      <p className=\"strategy-summary\">{section.summary}</p>\n      <ul className=\"strategy-list\">\n        {section.bullets.map((bullet) => (\n          <li key={bullet}>{bullet}</li>\n        ))}\n      </ul>\n    </article>\n  )\n}\n\nfunction App() {\n  const [dashboard, setDashboard] = useState<DashboardPayload | null>(null)\n  const [loading, setLoading] = useState(true)\n  const [refreshing, setRefreshing] = useState(false)\n  const [publishing, setPublishing] = useState(false)\n  const [error, setError] = useState<string | null>(null)\n  const [timeZone, setTimeZone] = useState<\"Asia/Shanghai\" | \"America/New_York\">(\"Asia/Shanghai\")\n\n  useEffect(() => {\n    let active = true\n\n    fetchDashboard()\n      .then((payload) => {\n        if (!active) return\n        startTransition(() => {\n          setDashboard(payload)\n          setError(null)\n          setLoading(false)\n        })\n      })\n      .catch((err: Error) => {\n        if (!active) return\n        setError(err.message)\n        setLoading(false)\n      })\n\n    return () => {\n      active = false\n    }\n  }, [])\n\n  async function handleRefresh() {\n    setRefreshing(true)\n    try {\n      const payload = await refreshDashboard()\n      startTransition(() => {\n        setDashboard(payload)\n        setError(null)\n      })\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"刷新失败\")\n    } finally {\n      setRefreshing(false)\n    }\n  }\n\n  async function handlePublish() {\n    setPublishing(true)\n    try {\n      const payload = await publishNotionBrief()\n      startTransition(() => {\n        setDashboard(payload)\n        setError(null)\n      })\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"同步到 Notion 失败\")\n    } finally {\n      setPublishing(false)\n    }\n  }\n\n  if (loading) {\n    return <main className=\"app-shell loading-state\">正在加载美国宏观看板...</main>\n  }\n\n  if (error && !dashboard) {\n    return (\n      <main className=\"app-shell loading-state\">\n        <p>加载失败：{error}</p>\n        <button className=\"action-button\" onClick={handleRefresh} type=\"button\">\n          重试\n        </button>\n      </main>\n    )\n  }\n\n  if (!dashboard) {\n    return null\n  }\n\n  return (\n    <main className=\"app-shell\">\n      <section className=\"toolbar\">\n        <div className=\"toolbar-left\">\n          <button className=\"action-button\" disabled={refreshing} onClick={handleRefresh} type=\"button\">\n            {refreshing ? \"刷新中...\" : \"手动刷新\"}\n          </button>\n          <button className=\"secondary-button\" disabled={publishing} onClick={handlePublish} type=\"button\">\n            {publishing ? \"同步中...\" : \"同步到 Notion\"}\n          </button>\n          <div className=\"timezone-toggle\">\n            <button\n              className={timeZone === \"Asia/Shanghai\" ? \"active\" : \"\"}\n              onClick={() => setTimeZone(\"Asia/Shanghai\")}\n              type=\"button\"\n            >\n              北京时间\n            </button>\n            <button\n              className={timeZone === \"America/New_York\" ? \"active\" : \"\"}\n              onClick={() => setTimeZone(\"America/New_York\")}\n              type=\"button\"\n            >\n              美东时间\n            </button>\n          </div>\n        </div>\n        <div className=\"source-grid\">\n          <span>FRED: {sourceLabel(dashboard.sourceStatus.fred)}</span>\n          <span>Treasury: {sourceLabel(dashboard.sourceStatus.treasury)}</span>\n          <span>Calendars: {sourceLabel(dashboard.sourceStatus.releases)}</span>\n          <span>News: {sourceLabel(dashboard.sourceStatus.news)}</span>\n          <span>AI: {sourceLabel(dashboard.sourceStatus.ai)}</span>\n        </div>\n      </section>\n\n      <section className=\"publishing-panel\">\n        <div>\n          <p className=\"eyebrow\">Distribution</p>\n          <h2>每日摘要写入 Notion 数据库</h2>\n          <p>{dashboard.publishing.statusText}</p>\n        </div>\n        <div className=\"publishing-meta\">\n          {dashboard.publishing.latestPageUrl ? (\n            <a href={dashboard.publishing.latestPageUrl} rel=\"noreferrer\" target=\"_blank\">\n              打开最新 Notion 页面\n            </a>\n          ) : null}\n          {dashboard.publishing.latestBriefPath ? <span>Fallback file: {dashboard.publishing.latestBriefPath}</span> : null}\n        </div>\n      </section>\n\n      {!dashboard.configStatus.fredConfigured || !dashboard.configStatus.notionConfigured || !dashboard.configStatus.deepseekConfigured ? (\n        <section className=\"setup-banner\">\n          {!dashboard.configStatus.fredConfigured ? (\n            <p>尚未配置 `FRED_API_KEY`。增长和通胀模块不会完整，页面会优先展示 Treasury 与官方日历数据。</p>\n          ) : null}\n          {!dashboard.configStatus.notionConfigured ? (\n            <p>尚未配置 `NOTION_API_KEY` 和 `NOTION_DATA_SOURCE_ID`。系统会保留本地摘要，但不会写入 Notion 数据库。</p>\n          ) : null}\n          {!dashboard.configStatus.deepseekConfigured ? (\n            <p>尚未配置 `DEEPSEEK_API_KEY`。当前只会显示规则层判断，不会叠加 DeepSeek 深度分析和新闻摘要。</p>\n          ) : null}\n        </section>\n      ) : null}\n\n      {dashboard.warnings.length ? (\n        <section className=\"warning-ribbon\">\n          {dashboard.warnings.map((warning) => (\n            <p key={warning}>{warning}</p>\n          ))}\n        </section>\n      ) : null}\n\n      <section className=\"strategy-grid\">\n        {renderStrategyPanel(\n          dashboard.strategy.regimeCall.title,\n          dashboard.strategy.regimeCall.summary,\n          dashboard.strategy.regimeCall.bullets,\n        )}\n        {renderStrategyPanel(\n          dashboard.strategy.allocationAdvice.title,\n          dashboard.strategy.allocationAdvice.summary,\n          dashboard.strategy.allocationAdvice.bullets,\n        )}\n      </section>\n\n      {dashboard.aiOverlay.enabled ? (\n        <section className=\"panel-card ai-overlay-panel\">\n          <div className=\"panel-head\">\n            <div>\n              <p className=\"eyebrow\">DeepSeek Overlay</p>\n              <h2>AI 深度分析</h2>\n            </div>\n            <div className=\"ai-meta\">\n              <span>Model {dashboard.aiOverlay.model}</span>\n              <span>Reasoning {dashboard.aiOverlay.reasoningEffort}</span>\n              <span>\n                {dashboard.aiOverlay.generatedAtLocal ? `更新于 ${dashboard.aiOverlay.generatedAtLocal}` : \"等待首次生成\"}\n              </span>\n            </div>\n          </div>\n          {dashboard.aiOverlay.sections ? (\n            <>\n              <div className=\"ai-grid\">\n                {renderAiSection(\"AI Regime Judgment\", dashboard.aiOverlay.sections.regimeJudgment)}\n                {renderAiSection(\"AI Asset Allocation\", dashboard.aiOverlay.sections.assetAllocation)}\n                {renderAiSection(\"AI Sector Allocation\", dashboard.aiOverlay.sections.sectorAllocation)}\n              </div>\n              {dashboard.aiOverlay.sections.keyRisks?.length ? (\n                <div className=\"ai-risks\">\n                  <h3>AI Key Risks</h3>\n                  <ul className=\"strategy-list\">\n                    {dashboard.aiOverlay.sections.keyRisks.map((risk) => (\n                      <li key={risk}>{risk}</li>\n                    ))}\n                  </ul>\n                </div>\n              ) : null}\n            </>\n          ) : (\n            <p className=\"strategy-summary\">\n              {dashboard.aiOverlay.error\n                ? `DeepSeek 分析暂时不可用：${dashboard.aiOverlay.error}`\n                : \"DeepSeek 已启用，等待首次生成分析。\"}\n            </p>\n          )}\n        </section>\n      ) : null}\n\n      <section className=\"monitor-grid\">\n        {renderMonitorPanel(\n          dashboard.monitor.us.title,\n          dashboard.monitor.us.dataUpdates,\n          dashboard.monitor.us.news,\n          timeZone,\n        )}\n        {renderMonitorPanel(\n          dashboard.monitor.global.title,\n          dashboard.monitor.global.dataUpdates,\n          dashboard.monitor.global.news,\n          timeZone,\n        )}\n      </section>\n\n      <section className=\"hero-panel\">\n        <div className=\"hero-copy\">\n          <p className=\"eyebrow\">Today's Macro Shift</p>\n          <h1>{dashboard.headline.title}</h1>\n          <p className=\"hero-summary\">{dashboard.headline.summary}</p>\n          <div className=\"hero-meta\">\n            <span>最近刷新 {formatDateTime(dashboard.generatedAt, timeZone)}</span>\n            <span>默认时区 {dashboard.timeZone}</span>\n            <span>Notion {dashboard.publishing.mode === \"notion\" ? \"Enabled\" : \"Fallback\"}</span>\n          </div>\n        </div>\n\n        <div className={`regime-panel ${regimeTone(dashboard.regimeState.regime)}`}>\n          <span className=\"regime-label\">Current Regime</span>\n          <strong>{dashboard.regimeState.regime}</strong>\n          <span>置信度 {Math.round(dashboard.regimeState.confidence * 100)}%</span>\n          <div className=\"score-strip score-strip-3\">\n            <div>\n              <small>Growth Score</small>\n              <strong>{dashboard.regimeState.scores.growth}</strong>\n            </div>\n            <div>\n              <small>Inflation Score</small>\n              <strong>{dashboard.regimeState.scores.inflation}</strong>\n            </div>\n            <div>\n              <small>Credit Score</small>\n              <strong>{dashboard.regimeState.scores.credit}</strong>\n            </div>\n          </div>\n          <ul className=\"driver-list\">\n            {dashboard.regimeState.drivers.map((driver) => (\n              <li key={driver}>{driver}</li>\n            ))}\n          </ul>\n        </div>\n      </section>\n\n      <section className=\"signal-grid\">\n        {dashboard.topSignals.map((signal) => (\n          <article className=\"signal-card\" key={signal.key}>\n            <small>{signal.label}</small>\n            <strong>{signal.valueText}</strong>\n            <span>{signal.marketSignal}</span>\n            <time>{signal.date}</time>\n          </article>\n        ))}\n      </section>\n\n      <section className=\"insight-grid\">\n        <article className=\"panel-card\">\n          <div className=\"panel-head\">\n            <h2>主动提醒 Feed</h2>\n            <span>{dashboard.feed.length} 条</span>\n          </div>\n          <div className=\"feed-list\">\n            {dashboard.feed.length ? (\n              dashboard.feed.map((item) => (\n                <article className={`feed-item severity-${item.severity}`} key={item.alertId}>\n                  <div className=\"feed-topline\">\n                    <strong>{item.title}</strong>\n                    <span>{formatDateTime(item.createdAt, timeZone)}</span>\n                  </div>\n                  <p>{item.body}</p>\n                  <small>{item.impactedAssets.join(\" / \")}</small>\n                </article>\n              ))\n            ) : (\n              <article className=\"feed-item severity-low\">\n                <div className=\"feed-topline\">\n                  <strong>还没有新的变化提醒</strong>\n                </div>\n                <p>完成一次手动刷新，或等下一条关键数据发布后，这里会累计新的变化记录。</p>\n              </article>\n            )}\n          </div>\n        </article>\n\n        <article className=\"panel-card\">\n          <div className=\"panel-head\">\n            <h2>未来 7 天关键发布</h2>\n            <span>{dashboard.releases.sevenDays.length} 项</span>\n          </div>\n          <div className=\"release-list\">{dashboard.releases.sevenDays.map((event) => renderRelease(event, timeZone))}</div>\n        </article>\n      </section>\n\n      <section className=\"panel-card\">\n        <div className=\"panel-head\">\n          <h2>未来 30 天发布日历</h2>\n          <span>{dashboard.releases.thirtyDays.length} 项</span>\n        </div>\n        <div className=\"calendar-grid\">{dashboard.releases.thirtyDays.map((event) => renderRelease(event, timeZone))}</div>\n      </section>\n\n      {dashboard.sections.map((section) => renderSection(section))}\n    </main>\n  )\n}\n\nexport default App\n",
