{
  "name": "macro-regime-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm --prefix client run dev -- --host 0.0.0.0\"",
    "dev:server": "node --watch server/src/index.js",
    "build": "npm --prefix client run build",
    "build:all": "npm run build",
    "check:live": "node server/src/liveCheck.js",
    "refresh:remote": "node scripts/render-refresh.mjs",
    "preview:sample": "node server/src/mockPreviewServer.js",
    "start": "node server/src/index.js",
    "test": "node --test server/test/*.test.js"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.3.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
